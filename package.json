{
  "name": "@deijose/nix-js-kit",
  "version": "2.4.2",
  "description": "Full-stack meta-framework for Nix.js — file-based routing, SSG and islands.",
  "license": "MIT",
  "author": "Deiver Vasquez",
  "homepage": "https://github.com/DeijoseDevelop/nix-js-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeijoseDevelop/nix-js-kit.git"
  },
  "type": "module",
  "keywords": [
    "nix-js",
    "meta-framework",
    "ssg",
    "islands",
    "file-based-routing",
    "ssr",
    "typescript"
  ],
  "main": "./dist/lib/index.cjs",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/lib/index.d.ts",
        "require": "./dist/lib/index.d.cts"
      },
      "import": "./dist/lib/index.js",
      "require": "./dist/lib/index.cjs"
    },
    "./island": {
      "types": {
        "import": "./dist/lib/island/index.d.ts",
        "require": "./dist/lib/island/index.d.cts"
      },
      "import": "./dist/lib/island/index.js",
      "require": "./dist/lib/island/index.cjs"
    },
    "./cli": {
      "types": {
        "import": "./dist/lib/cli.d.ts",
        "require": "./dist/lib/cli.d.cts"
      },
      "import": "./dist/lib/cli.js",
      "require": "./dist/lib/cli.cjs"
    },
    "./vite": {
      "types": {
        "import": "./dist/lib/vite/index.d.ts",
        "require": "./dist/lib/vite/index.d.cts"
      },
      "import": "./dist/lib/vite/index.js",
      "require": "./dist/lib/vite/index.cjs"
    },
    "./adapters": {
      "types": {
        "import": "./dist/lib/adapters/index.d.ts",
        "require": "./dist/lib/adapters/index.d.cts"
      },
      "import": "./dist/lib/adapters/index.js",
      "require": "./dist/lib/adapters/index.cjs"
    },
    "./adapters/vercel": {
      "types": {
        "import": "./dist/lib/adapters/vercel.d.ts",
        "require": "./dist/lib/adapters/vercel.d.cts"
      },
      "import": "./dist/lib/adapters/vercel.js",
      "require": "./dist/lib/adapters/vercel.cjs"
    },
    "./adapters/netlify": {
      "types": {
        "import": "./dist/lib/adapters/netlify.d.ts",
        "require": "./dist/lib/adapters/netlify.d.cts"
      },
      "import": "./dist/lib/adapters/netlify.js",
      "require": "./dist/lib/adapters/netlify.cjs"
    },
    "./adapters/bun": {
      "types": {
        "import": "./dist/lib/adapters/bun.d.ts",
        "require": "./dist/lib/adapters/bun.d.cts"
      },
      "import": "./dist/lib/adapters/bun.js",
      "require": "./dist/lib/adapters/bun.cjs"
    },
    "./adapters/node": {
      "types": {
        "import": "./dist/lib/adapters/node.d.ts",
        "require": "./dist/lib/adapters/node.d.cts"
      },
      "import": "./dist/lib/adapters/node.js",
      "require": "./dist/lib/adapters/node.cjs"
    },
    "./action": {
      "types": {
        "import": "./dist/lib/action/index.d.ts",
        "require": "./dist/lib/action/index.d.cts"
      },
      "import": "./dist/lib/action/index.js",
      "require": "./dist/lib/action/index.cjs"
    },
    "./router": {
      "types": {
        "import": "./dist/lib/router/client.d.ts",
        "require": "./dist/lib/router/client.d.cts"
      },
      "import": "./dist/lib/router/client.js",
      "require": "./dist/lib/router/client.cjs"
    },
    "./content": {
      "types": {
        "import": "./dist/lib/content/index.d.ts",
        "require": "./dist/lib/content/index.d.cts"
      },
      "import": "./dist/lib/content/index.js",
      "require": "./dist/lib/content/index.cjs"
    },
    "./image": {
      "types": {
        "import": "./dist/lib/image/index.d.ts",
        "require": "./dist/lib/image/index.d.cts"
      },
      "import": "./dist/lib/image/index.js",
      "require": "./dist/lib/image/index.cjs"
    },
    "./seo": {
      "types": {
        "import": "./dist/lib/seo/index.d.ts",
        "require": "./dist/lib/seo/index.d.cts"
      },
      "import": "./dist/lib/seo/index.js",
      "require": "./dist/lib/seo/index.cjs"
    },
    "./config": {
      "types": {
        "import": "./dist/lib/config/index.d.ts",
        "require": "./dist/lib/config/index.d.cts"
      },
      "import": "./dist/lib/config/index.js",
      "require": "./dist/lib/config/index.cjs"
    },
    "./manifest": {
      "types": {
        "import": "./dist/lib/manifest/index.d.ts",
        "require": "./dist/lib/manifest/index.d.cts"
      },
      "import": "./dist/lib/manifest/index.js",
      "require": "./dist/lib/manifest/index.cjs"
    },
    "./integrations": {
      "types": {
        "import": "./dist/lib/integrations/index.d.ts",
        "require": "./dist/lib/integrations/index.d.cts"
      },
      "import": "./dist/lib/integrations/index.js",
      "require": "./dist/lib/integrations/index.cjs"
    },
    "./runtime": {
      "types": {
        "import": "./dist/lib/runtime/index.d.ts",
        "require": "./dist/lib/runtime/index.d.cts"
      },
      "import": "./dist/lib/runtime/index.js",
      "require": "./dist/lib/runtime/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "island": [
        "./dist/lib/island/index.d.ts"
      ],
      "cli": [
        "./dist/lib/cli.d.ts"
      ],
      "vite": [
        "./dist/lib/vite/index.d.ts"
      ],
      "adapters/vercel": [
        "./dist/lib/adapters/vercel.d.ts"
      ],
      "adapters/netlify": [
        "./dist/lib/adapters/netlify.d.ts"
      ],
      "adapters/bun": [
        "./dist/lib/adapters/bun.d.ts"
      ],
      "adapters/node": [
        "./dist/lib/adapters/node.d.ts"
      ],
      "adapters": [
        "./dist/lib/adapters/index.d.ts"
      ],
      "action": [
        "./dist/lib/action/index.d.ts"
      ],
      "router": [
        "./dist/lib/router/client.d.ts"
      ],
      "content": [
        "./dist/lib/content/index.d.ts"
      ],
      "image": [
        "./dist/lib/image/index.d.ts"
      ],
      "seo": [
        "./dist/lib/seo/index.d.ts"
      ],
      "config": [
        "./dist/lib/config/index.d.ts"
      ],
      "manifest": [
        "./dist/lib/manifest/index.d.ts"
      ],
      "integrations": [
        "./dist/lib/integrations/index.d.ts"
      ],
      "runtime": [
        "./dist/lib/runtime/index.d.ts"
      ],
      "*": [
        "./dist/lib/index.d.ts"
      ]
    }
  },
  "files": [
    "dist/lib",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "nix-js-kit": "./bin/nix-js-kit.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "poc": "bun run example/build.ts",
    "build:example": "bun run example/build.ts",
    "build:client": "vite build --config example/vite.client.config.ts",
    "dev:example": "node bin/nix-js-kit.js dev --root example --hydrate-import ../../src/island/index.ts --client-config vite.client.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/**/*.test.ts",
    "publint": "publint",
    "check:types": "attw --pack .",
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.cli.config.ts && tsc --project tsconfig.lib.json && node scripts/copy-dcts.mjs && terser dist/lib/index.js -c -m -o dist/lib/index.js && terser dist/lib/index.cjs -c -m -o dist/lib/index.cjs && terser dist/lib/island/index.js -c -m -o dist/lib/island/index.js && terser dist/lib/island/index.cjs -c -m -o dist/lib/island/index.cjs",
    "prepack": "npm run build:lib",
    "test:e2e:hmr": "playwright test --config example/playwright.config.ts"
  },
  "dependencies": {
    "tsx": "^4.23.12"
  },
  "peerDependencies": {
    "@deijose/nix-js": "^3.5.0",
    "@deijose/vite-plugin-nix-js": "^2.0.2",
    "vite": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "marked": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "@deijose/vite-plugin-nix-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deijose/nix-js": "../nix-js-microframework",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "terser": "^5.50.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}