{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "allowImportingTsExtensions": false,
        "declaration": true,
        "declarationDir": "dist/lib",
        "emitDeclarationOnly": true,
        "rootDir": "src"
    },
    "include": [
        "src/index.ts",
        "src/island/index.ts",
        "src/vite/index.ts",
        "src/adapters/index.ts",
        "src/adapters/vercel.ts",
        "src/adapters/netlify.ts",
        "src/adapters/bun.ts",
        "src/adapters/node.ts",
        "src/action/index.ts",
        "src/action/server.ts",
        "src/action/scan.ts",
        "src/action/origin.ts",
        "src/action/error-store.ts",
        "src/router/client.ts",
        "src/content/index.ts",
        "src/content/collections.ts",
        "src/content/frontmatter.ts",
        "src/content/markdown.ts",
        "src/content/schema.ts",
        "src/content/raw.ts",
        "src/image/index.ts",
        "src/image/pipeline.ts",
        "src/image/service.ts",
        "src/image/registry.ts",
        "src/middleware/index.ts",
        "src/middleware/stream-boundary.ts",
        "src/seo/index.ts",
        "src/cli.ts",
        "src/runtime/index.ts",
        "src/runtime/context.ts",
        "src/runtime/handler.ts",
        "src/runtime/static.ts",
        "src/runtime/node-http.ts",
        "src/config/index.ts",
        "src/manifest/index.ts",
        "src/integrations/index.ts",
        "src/build/vite-build.ts"
    ],
    "exclude": [
        "src/__tests__",
        "example"
    ]
}